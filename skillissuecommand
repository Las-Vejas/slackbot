app.command("/v-test", async ({ command, ack, respond }) => {
  const start = Date.now();
  await ack();
  const latency = Date.now() - start;
  await respond({ text: `Pong!\nLatency: ${latency}ms` });
});

app.command("/skill-issue", async ({ ack, body, respond }) => {
  await ack();
  
  const response =
    skillIssueResponses[Math.floor(Math.random() * skillIssueResponses.length)];
  const mentionText = body.text.trim();

  const message = mentionText
    ? `${mentionText} ${response}`
    : `<@${body.user_id}> ${response}`;

  await respond({
    text: message,
    response_type: "in_channel",
  });
});

// Auto-detect complaints and roast (only in your channel)
app.message(/didn't work|doesn't work|broken|bug|error|fail|crash|not working|wtf|this sucks/i, async ({ say, message }) => {
  // Replace "YOUR_CHANNEL_ID" with your actual channel ID
  if (message.channel !== "C0B6TNB4BSB") return;
  
  const response =
    skillIssueResponses[Math.floor(Math.random() * skillIssueResponses.length)];
  
  say(`<@${message.user}> ${response}`);
});